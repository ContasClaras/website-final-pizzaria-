rules_version = '2';
// BELLA DOMUS — Regras de segurança do Firestore
// ------------------------------------------------------------
// Copiar e colar isto em: Firebase Console > Firestore Database > Rules > Publicar
//
// O que isto garante:
// - Qualquer visitante pode CRIAR um pedido de reserva (com estado "pending"),
//   mas não pode ler, alterar ou apagar reservas.
// - Só a equipa autenticada (login no admin.html) pode ver, aceitar, recusar
//   ou apagar reservas, e gerir a lista de mesas.
// - Qualquer visitante pode LER a lista de mesas (não é informação sensível),
//   mas só a equipa autenticada pode alterá-la.

service cloud.firestore {
  match /databases/{database}/documents {

    match /reservations/{reservationId} {
      allow create: if request.resource.data.status == 'pending'
                     && request.resource.data.name is string
                     && request.resource.data.email is string
                     && request.resource.data.date is string
                     && request.resource.data.time is string
                     && request.resource.data.partySize is number;
      allow read, update, delete: if request.auth != null;
    }

    match /tables/{tableId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
